<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform>x64</Platform><OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ZWLibrary</AssemblyName><RootNamespace>ZWLibrary</RootNamespace>
    <OutputPath>..\output\v0.8.4-ai.1\plugin\</OutputPath><Optimize>true</Optimize>
    <ZwcadDir Condition="'$(ZwcadDir)' == ''">C:\Program Files\ZWSOFT\ZWCAD 2024</ZwcadDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" /><Reference Include="System.Web.Extensions" /><Reference Include="System.Security" /><Reference Include="System.Web" /><Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Xml" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" /><Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
    <Reference Include="ZwManaged"><HintPath>$(ZwcadDir)\ZwManaged.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ZwDatabaseMgd"><HintPath>$(ZwcadDir)\ZwDatabaseMgd.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="ChatGptLogin.cs" /><Compile Include="AgentApi.cs" /><Compile Include="AgentDialog.cs" /><Compile Include="Agent.cs" /><Compile Include="AutoPreview.cs" /><Compile Include="PartsPanel.cs" /><Compile Include="GeometryPanel.cs" /><Compile Include="Reporting.cs" /><Compile Include="CurrentAttributeReader.cs" /><Compile Include="PartListCommands.cs" /><Compile Include="GeometryCommands.cs" /><Compile Include="InsertionCommands.cs" /><Compile Include="BatchInsertion.cs" /><Compile Include="CatalogUI.cs" /><Compile Include="LayoutCommands.cs" /><Compile Include="Preview.cs" /><Compile Include="PreviewCanvas.cs" /><Compile Include="Core.cs" /><Compile Include="UI.cs" /><Compile Include="SettingsDialog.cs" /><Compile Include="Plugin.cs" /><Compile Include="AuditCommands.cs" />
  </ItemGroup>
  <Target Name="CheckZwcadReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ZwcadDir)\ZwManaged.dll') Or !Exists('$(ZwcadDir)\ZwDatabaseMgd.dll')" Text="ZwcadDir을 ZWCAD 2024 설치 폴더로 설정하세요." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
